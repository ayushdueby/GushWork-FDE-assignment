# ---- Required ---------------------------------------------------------------
# Local dev: SQLite file. Production: Neon Postgres connection string
# (postgresql://user:pass@host/db?sslmode=require). The Prisma provider flips automatically.
DATABASE_URL=file:./dev.db

# Public URL of the app (used in emails, quote links, Twilio callbacks).
APP_URL=http://localhost:3000

# Signs the demo-login session cookie. Any long random string.
SESSION_SECRET=change-me

# ---- Groq (real AI) ----------------------------------------------------------
# Leave blank to run on the deterministic rule-based fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_MOCK=1 makes every AI call return the deterministic fallback (used by E2E tests).
# AI_DISABLED=1 forces the fallback even when a key is present.

# ---- Twilio (real SMS + voice; inactive when blank) ---------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Gmail (real mailbox; inactive when blank) --------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# ---- Misc ------------------------------------------------------------------
# COOKIE_SECURE=0   # only if you must run production over plain http
# PRISMA_LOG=1      # log every query
